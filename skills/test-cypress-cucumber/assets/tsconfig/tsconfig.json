{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["test/e2e/pages/*"],
      "@utils/*": ["test/e2e/utils/*"],
      "@support/*": ["test/e2e/support/*"],
      "@fixtures/*": ["test/e2e/fixtures/*"]
    },
    "types": ["cypress"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/e2e/**/*.ts", "**/*.feature", "cypress.config.ts"],
  "exclude": ["node_modules", "dist", "reports", "test/e2e/videos", "test/e2e/screenshots"]
}
